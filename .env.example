# Copiar a .env.local para desarrollo y añadir las mismas variables en Vercel
# (Project → Settings → Environment Variables).

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Acceso a la app
APP_PASSWORD=elige-una-contraseña
# Cadena aleatoria larga; genérala con: openssl rand -hex 32
AUTH_SECRET=cambia-esto
