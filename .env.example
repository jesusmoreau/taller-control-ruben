# Copiar a .env.local para desarrollo y añadir las mismas variables en Vercel
# (Project → Settings → Environment Variables).

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Contraseña del primer taller (los demás se crean con scripts/crear-taller.mjs)
APP_PASSWORD=elige-una-contraseña
# Cadena aleatoria larga; genérala con: openssl rand -hex 32. Firma las cookies de sesión.
AUTH_SECRET=cambia-esto

# Solo para los scripts de administración (scripts/): conexión directa a Postgres.
# Supabase → Connect → Direct connection (o la crea la integración de Vercel).
POSTGRES_URL_NON_POOLING=postgres://postgres:xxx@db.xxxxxxxx.supabase.co:5432/postgres
